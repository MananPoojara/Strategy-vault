{
  "name": "strategy-vault-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-login.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "build:login": "node scripts/build-login.mjs"
  },
  "dependencies": {
    "html-react-parser": "6.1.8",
    "lenis": "1.3.27",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "jsdom": "28.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
